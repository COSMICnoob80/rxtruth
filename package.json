{
  "name": "rxtruth",
  "version": "0.1.0",
  "description": "RxTruth — Medical Misinformation Radar built on the Telegraph intelligence layer. Harvests viral health claims, verifies them against live Telegraph Miners (news search, AI-text detection, LLM fact-checking), and publishes a daily Health Misinformation Index with on-chain proof for every inference.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "run:once": "tsx src/scripts/runOnce.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "telegraph",
    "x402",
    "health",
    "misinformation",
    "agents"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@scure/base": "^2.2.0",
    "@solana/kit": "^5.5.1",
    "@x402/fetch": "^2.11.0",
    "@x402/svm": "^2.11.0",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "twitter-api-v2": "^1.18.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  }
}
