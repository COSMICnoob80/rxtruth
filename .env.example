# ── Server ─────────────────────────────────────────────────────────────
PORT=3001
# Shared secret required for POST /api/run (manual pipeline trigger)
RUN_TOKEN=change-me

# ── Telegraph engine ───────────────────────────────────────────────────
# Always port 7044 — port 80 is an nginx UI that 405s POST requests.
TELEGRAPH_BASE_URL=http://13.237.89.59:7044

# Subnet paths (defaults match the official telegraph-usecases examples)
DESEARCH_PATH=/subnet-dispatcher/v1/101/search/mini
GROQ_PATH=/subnet-dispatcher/v1/102/chat
ITSAI_PATH=/subnet-dispatcher/v1/32

# Model used on the Groq LLM subnet (102) — confirm current model names
# in the Telegraph Discord #hackathon channel.
GROQ_MODEL=groq/compound-mini

# ── x402 payments (Solana devnet, ScholarGuard pattern) ────────────────
# Base58 private key of a devnet wallet funded with devnet USDC.
# Without it, requests proceed without payment and Miner calls will 402.
SOLANA_PRIVATE_KEY=
SOLANA_NETWORK=devnet

# ── Pipeline ───────────────────────────────────────────────────────────
# Cron schedule for autonomous harvest+verify runs (default: every 6h)
CRON_SCHEDULE=0 */6 * * *
# Max claims verified per run (each claim = 2-3 paid Miner calls)
MAX_CLAIMS_PER_RUN=8
# Comma-separated harvest queries for DeSearch
HARVEST_QUERIES=viral health claim,miracle cure warning,health misinformation trend,dangerous home remedy,viral medical advice

# ── X (Twitter) auto-posting — optional ────────────────────────────────
# Create an app at developer.x.com (free tier). Leave empty to disable
# auto-posting; the daily index is always visible on the dashboard.
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
